<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Avec les Femmes{% endblock %} · Avec les Femmes</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🪙</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="entete">
            <div class="conteneur entete__contenu">
                <a href="{{ path('app_groupement_index') }}" class="logo">
                    <span class="logo__pastille">AF</span> Avec les Femmes
                </a>
                <nav class="nav">
                    <a href="{{ path('app_groupement_index') }}">Groupements</a>
                </nav>
            </div>
        </header>

        <main class="conteneur">
            {% block fil_ariane %}{% endblock %}
            {% block body %}{% endblock %}
        </main>

        <footer class="pied conteneur">Gestion des tontines et épargnes des groupements de femmes</footer>
    </body>
</html>